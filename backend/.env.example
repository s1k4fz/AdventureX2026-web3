# Supabase project API URL (no trailing slash)
SUPABASE_URL=https://your-project-ref.supabase.co

# Audience claim on Supabase user access tokens (leave as-is)
SUPABASE_JWT_AUDIENCE=authenticated

# Only needed for legacy Supabase projects that still issue HS256 user tokens.
# Leave empty for projects using asymmetric JWT signing keys / JWKS.
SUPABASE_JWT_SECRET=

# Async Postgres connection string for SQLAlchemy (asyncpg driver).
# Copy the connection string from the Supabase dashboard:
#   Connect -> Session pooler
# then change the scheme to "postgresql+asyncpg://" and fill in your password.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Local API bind address and non-default port
API_HOST=127.0.0.1
API_PORT=18473

# Route prefix for the versioned API. Frontend VITE_API_BASE_URL points at the
# host only, so changing this requires updating the frontend client too.
# API_V1_PREFIX=/api/v1

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://127.0.0.1:15432,http://localhost:15432

# --- DeepSeek OpenAI-compatible (main text/policy agents). Server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash

# --- A2A remote agent ---
A2A_ENABLED=true
A2A_URL=http://127.0.0.1:18473/a2a
A2A_SYSTEM_USER_ID=

# PandaAI / pandaData (optional A-share context)
# PANDAAI_ENABLED=false disables the subagent even if credentials are set.
# PANDAAI_MODULES selects datasets (comma-separated).
# PANDAAI_ENABLED=false
# PANDAAI_USERNAME=
# PANDAAI_PASSWORD=
# PANDAAI_BASE_URL=http://pandadata.pandaaiquant.com
# PANDAAI_TIMEOUT_SECONDS=20
# PANDAAI_CACHE_TTL_SECONDS=300
# PANDAAI_MODULES=index,futures,macro,calendar

# StepFun key is required for Realtime voice proxy.
STEPFUN_API_KEY=your-stepfun-key

# StepFun Realtime stays behind the authenticated backend WebSocket proxy.
STEPFUN_REALTIME_BASE_URL=wss://api.stepfun.com/step_plan/v1/realtime
STEPFUN_REALTIME_MODEL=stepaudio-2.5-realtime
STEPFUN_REALTIME_VOICE=linjiajiejie
STEPFUN_REALTIME_INSTRUCTIONS=你是 Lemma 的实时语音助手。回答自然、清晰、简洁。
REALTIME_PROXY_AUTH_TIMEOUT_SECONDS=5
REALTIME_PROXY_MAX_SESSION_SECONDS=1800
REALTIME_PROXY_MAX_SESSIONS_PER_USER=2
REALTIME_PROXY_MAX_MESSAGE_BYTES=1048576
REALTIME_PROXY_MAX_AUDIO_CHUNK_BYTES=524288
REALTIME_PROXY_REQUIRE_ORIGIN=true

# Default HTTP timeout for AI calls, in seconds
AI_DEFAULT_TIMEOUT_SECONDS=30

# Use-case -> ordered model candidates (DeepSeek OpenAI-compatible only).
# AI_ROUTES_JSON={"text_chat":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"policy_intake":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"market_search":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"market_search_refined":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"portfolio_compose":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":120,"extra":{"max_tokens":16384}}],"policy_plan_intro":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-flash","priority":0,"timeout_s":30}],"source_brief":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-flash","priority":0,"timeout_s":45,"extra":{"max_tokens":2048}}]}
AI_ROUTES_JSON={"text_chat":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"policy_intake":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"market_search":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"market_search_refined":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":60}],"portfolio_compose":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-pro","priority":0,"timeout_s":120,"extra":{"max_tokens":16384}}],"policy_plan_intro":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-flash","priority":0,"timeout_s":30}],"source_brief":[{"platform":"deepseek","adapter":"openai_compatible","model":"deepseek-v4-flash","priority":0,"timeout_s":45,"extra":{"max_tokens":2048}}]}

# --- Background tasks (Celery) ---
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# 差分机 (Difference Engine) — Injective 投保 dApp
# ============================================================================

# --- Market data (Polymarket Gamma, read-only) ---
# Anonymous/free public API — no key. Omit MARKETS_ROUTES_JSON to use the
# built-in default (Polymarket Gamma only; schema in ai/markets/config.py).
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
# MARKETS_ROUTES_JSON={"polymarket": [{"provider": "polymarket_gamma", "max_items": 40, "timeout_s": 30, "priority": 0, "extra": {}}]}

# --- WorldMonitor global intelligence (Agent context + policy UI) ---
# Default base is the public cloud API. Client always probes:
#   GET /api/health?compact=1
#   GET /api/bootstrap?tier=fast&public=1   (no Pro key required)
# Optional key unlocks Fear&Greed + live risk-score RPCs:
#   - Cloud Pro: wm_… from https://worldmonitor.app/pro
#   - Local self-host: any string listed in WM's WORLDMONITOR_VALID_KEYS
#     (see backend/ai/worldmonitor/LOCAL.md — recommended to avoid cloud key)
#
# WORLDMONITOR_API_BASE_URL=https://api.worldmonitor.app
# WORLDMONITOR_API_KEY=
# WORLDMONITOR_TIMEOUT_SECONDS=8
# WORLDMONITOR_CACHE_TTL_SECONDS=120
#
# --- Local WorldMonitor (no cloud Pro key) ---
# WM is vendored at repo-root ./worldmonitor/ (see root README + ai/worldmonitor/LOCAL.md).
# Put WORLDMONITOR_VALID_KEYS into worldmonitor/docker-compose.override.yml (not only .env).
# Minimal local stack (redis + redis-rest + worldmonitor only; no ais-relay):
#   ports WM HTTP 17300, Redis REST 18079.
# WORLDMONITOR_API_BASE_URL=http://localhost:17300
# WORLDMONITOR_API_KEY=lemma-local-dev-key
# WORLDMONITOR_TIMEOUT_SECONDS=15
#
# When the primary base (usually the local Docker WM) is unreachable or returns
# an unhealthy/empty snapshot, the client retries the cloud public endpoints.
# The optional key applies to the PRIMARY only. Set the flag to false to pin.
# WORLDMONITOR_CLOUD_BASE_URL=https://api.worldmonitor.app
# WORLDMONITOR_ENABLE_CLOUD_FALLBACK=true

# --- Bocha (博查) Web Search — server-side only ---
# Never put this key in frontend/.env.
# Used by: conversation web_search tool, policy web intel subagent (primary),
# and news subagent fallback when Google News RSS is empty/unavailable.
# BOCHA_API_KEY=your-bocha-api-key
# BOCHA_API_BASE_URL=https://api.bocha.cn/v1/web-search
# BOCHA_TIMEOUT_SECONDS=12
# BOCHA_CACHE_TTL_SECONDS=90
# BOCHA_DEFAULT_COUNT=8

# --- Agent Task runtime budgets ---
# AGENT_SEARCH_TIMEOUT_SECONDS=120
# AGENT_COMPOSE_TIMEOUT_SECONDS=180
# AGENT_STAGE_WEB_SEARCH_MAX=1

# --- Injective EVM testnet chain (public params) ---
# Legacy tx / no EIP-1559; gas price is a fixed 160e6 wei on testnet.
INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_EVM_CHAIN_ID=1439
INJECTIVE_EVM_GAS_PRICE_WEI=160000000

# --- Platform economics ---
# Fee收款地址 + 平台手续费（基点，100 = 1%）。
TREASURY_ADDRESS=
PLATFORM_FEE_BPS=100

# --- Secrets (testnet only — NEVER reuse on mainnet, NEVER commit) ---
# MVP: deployer and settle relayer share one testnet hot key; split in prod.
# 领 gas(INJ): https://testnet.faucet.injective.network/  领测试 USDC: https://faucet.circle.com/
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# --- Filled after M2 deploy ---
# PolicyVault 合约地址 + 测试网原生 USDC (MTS) 地址。
POLICY_VAULT_ADDRESS=
USDC_ADDRESS=

# --- Filled after PolicyNFT deploy ---
# Metadata base must end at the public decimal-token route. DeployNFT appends
# a slash if needed, then tokenURI appends the deterministic decimal tokenId.
POLICY_NFT_ADDRESS=
NFT_METADATA_BASE_URL=http://127.0.0.1:18473/api/v1/policies/nft/metadata
# Public frontend route; external_url becomes {base}/{decimalTokenId}.
NFT_PUBLIC_BASE_URL=http://127.0.0.1:15432/nft

# --- Filled after M3 oracle deploy (乐观预言机结算) ---
# OutcomeOracle 合约地址（settlePolicyFromOracle 读取它）。留空则结算走旧的
# relayer 直传 outcomes 路径。LIVENESS 秒数须与部署时一致（testnet 短、生产小时/天级）。
# BOND 为每次断言的抵押（USDC base units，6 位小数，10000000 = 10 USDC）。
OUTCOME_ORACLE_ADDRESS=
OUTCOME_ORACLE_LIVENESS_SECONDS=300
OUTCOME_ORACLE_BOND_BASE_UNITS=10000000

# --- Rokid Glasses HUD card feed (GET /api/v1/hud/stream) ---
# Per-connection poll cadence for the read-only sources. WorldMonitor keeps its
# own 120s client cache, so a 20s tick never amplifies upstream. See backend/HUD.md.
# HUD_POLL_INTERVAL_SECONDS=20
# HUD_HEARTBEAT_INTERVAL_SECONDS=15
# HUD_MAX_CARDS=30
#
# Dev-only auth bypass for the glasses demo: when BOTH are set, a Bearer equal
# to HUD_DEV_TOKEN authenticates /hud/* as HUD_DEV_USER_ID, so the phone needs
# no Supabase login. Empty (default) = disabled. NEVER set these in production.
# HUD_DEV_TOKEN=
# HUD_DEV_USER_ID=

# ============================================================================
# Deploy-time only — read by Foundry scripts (contracts/script/*.s.sol), NOT by
# the backend Settings. Pass them inline on the forge command line, e.g.
#   RELAYER=0x… ORACLE_BOND=10000000 forge script script/Deploy.s.sol …
# NFT_BASE_URI must equal NFT_METADATA_BASE_URL above (the contract normalizes
# the trailing slash). ORACLE_BOND / ORACLE_LIVENESS must match the
# OUTCOME_ORACLE_* values the backend uses after deployment.
# ============================================================================
# RELAYER=
# NFT_BASE_URI=
# ORACLE_BOND=10000000
# ORACLE_LIVENESS=300
