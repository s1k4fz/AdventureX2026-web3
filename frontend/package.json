{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:agent-events": "tsc --target ES2022 --module CommonJS --moduleResolution Node --skipLibCheck --esModuleInterop --outDir /tmp/xengine-agent-event-smoke src/features/agent/eventReducer.smoke.ts && node /tmp/xengine-agent-event-smoke/eventReducer.smoke.js",
    "test:journey": "tsc --target ES2022 --module CommonJS --moduleResolution Node --skipLibCheck --esModuleInterop --outDir /tmp/xengine-journey-smoke src/features/policy-journey/journeyReducer.smoke.ts && node /tmp/xengine-journey-smoke/policy-journey/journeyReducer.smoke.js",
    "test:policy-nft": "tsc --target ES2022 --module CommonJS --moduleResolution Node --skipLibCheck --esModuleInterop --outDir /tmp/xengine-policy-nft-smoke src/features/policy/policyNftUtils.smoke.ts && node /tmp/xengine-policy-nft-smoke/policyNftUtils.smoke.js",
    "test:oracle-status": "tsc --target ES2022 --module CommonJS --moduleResolution Node --skipLibCheck --esModuleInterop --outDir /tmp/xengine-oracle-status-smoke src/features/policy/oracleStatusUtils.smoke.ts src/features/policy/oracleStatusUtils.ts && node /tmp/xengine-oracle-status-smoke/oracleStatusUtils.smoke.js",
    "test:health-score": "npx --yes tsx src/features/policy-journey/components/PolicyHealthScore.smoke.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.91.0",
    "@vidstack/react": "^1.15.3",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.577.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.3",
    "radix-ui": "^1.5.0",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.10.0",
    "streamdown": "^2.5.0",
    "svg-dotted-map": "^2.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "viem": "^2.55.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
