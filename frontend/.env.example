# Supabase project URL (same as backend SUPABASE_URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — designed to be public, safe in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:18473

# --- Google login (Supabase Auth) ---
# 1. Google Cloud → OAuth client → Authorized redirect URI:
#    {VITE_SUPABASE_URL}/auth/v1/callback
# 2. Supabase Dashboard → Authentication → Providers → Google: enable + Client ID/Secret
# 3. Supabase → Authentication → URL Configuration → Redirect URLs: add
#    http://localhost:<vite-port>/login
#    https://<your-frontend-host>/login
# Frontend uses signInWithOAuth({ provider: 'google', redirectTo: origin + '/login' }).
# No email/password registration UI.

# PolicyNFT deployment on Injective EVM testnet. Leave empty until deployed;
# the NFT preview remains available but minting is disabled safely.
VITE_POLICY_NFT_ADDRESS=

# ============================================================================
# NOTE: every VITE_-prefixed value is inlined into the production bundle and is
# therefore PUBLIC. Only put values here that are safe to ship to a browser:
# the Supabase URL + publishable (anon) key, the backend base URL, and on-chain
# addresses. Anything else reaches the browser through an authenticated backend
# endpoint instead.
#
# These NEVER belong in this file — they live in backend/.env (gitignored):
#   DEEPSEEK_API_KEY, STEPFUN_API_KEY, BOCHA_API_KEY, WORLDMONITOR_API_KEY,
#   PANDAAI_USERNAME / PANDAAI_PASSWORD, DATABASE_URL, SUPABASE_JWT_SECRET,
#   DEPLOYER_PRIVATE_KEY / RELAYER_PRIVATE_KEY.
# ============================================================================
